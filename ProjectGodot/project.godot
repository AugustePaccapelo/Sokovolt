[internationalization]

locale/translations=PackedStringArray("res://Localisation/8_ROBOTNIK_Localisation.en.translation", "res://Localisation/8_ROBOTNIK_Localisation.fr.translation")

[memory]

limits/multithreaded_server/rid_pool_prealloc=120
limits/message_queue/max_size_mb=48

[physics]

2d/run_on_separate_thread=true

[rendering]

occlusion_culling/bvh_build_quality=0
rendering_device/staging_buffer/max_size_mb=256
rendering_device/staging_buffer/texture_upload_region_size_px=128
textures/canvas_textures/default_texture_filter=0
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=0
2d/shadow_atlas/size=512
reflections/sky_reflections/roughness_layers=4
reflections/sky_reflections/texture_array_reflections=false
reflections/sky_reflections/ggx_samples=16
reflections/reflection_atlas/reflection_size=128
reflections/reflection_atlas/reflection_count=32
global_illumination/gi/use_half_resolution=true
driver/depth_prepass/enable=false
textures/default_filters/anisotropic_filtering_level=0
camera/depth_of_field/depth_of_field_bokeh_shape=0
camera/depth_of_field/depth_of_field_bokeh_quality=0
environment/ssao/quality=1
environment/ssao/adaptive_target=0.0
environment/ssil/quality=0
environment/ssil/adaptive_target=0.0
environment/ssil/blur_passes=1
scaling_3d/scale=0.5
textures/decals/filter=0
textures/light_projectors/filter=0
environment/glow/upscale_mode=0
environment/screen_space_reflection/roughness_quality=0
environment/subsurface_scattering/subsurface_scattering_quality=0
global_illumination/sdfgi/probe_ray_count=0
global_illumination/sdfgi/frames_to_converge=0
global_illumination/sdfgi/frames_to_update_lights=4
environment/volumetric_fog/volume_size=32
environment/volumetric_fog/volume_depth=32
environment/volumetric_fog/use_filter=0
lightmapping/bake_quality/ultra_quality_ray_count=1024
lightmapping/bake_quality/ultra_quality_probe_ray_count=1024
mesh_lod/lod_change/threshold_pixels=2.0
